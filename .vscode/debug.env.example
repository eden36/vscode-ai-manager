# 可选：指定本机 VS Code 可执行文件。留空时自动从 PATH 中的 code 命令解析。
# 用于 npm run dev:vscode 与集成测试。
#
# Windows 示例：
# AI_MANAGER_VSCODE_EXECUTABLE=D:\auto_software\Microsoft.VisualStudioCode\Code.exe
#
# 默认安装路径示例：
# AI_MANAGER_VSCODE_EXECUTABLE=C:\Users\<你>\AppData\Local\Programs\Microsoft VS Code\Code.exe

AI_MANAGER_VSCODE_EXECUTABLE=D:\auto_software\Microsoft.VisualStudioCode\Code.exe
